{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theoroi.dev/schemas/wizardreal/spell.schema.json",
  "title": "wizardreal spell definition",
  "description": "Data-driven spell definition for data/<ns>/voicecast/spells/<file>.json, parsed by SpellDefinition.CODEC (wizardreal-common). Field documentation: docs/spells/spell_json.md in the workspace root repo. Addon-registered effect types are covered by the generic branch of the effects anyOf; built-in types are enumerated for editor assistance. Runtime parsing is lenient about unknown top-level keys, but this schema is stricter by design (typo protection).",
  "type": "object",
  "required": ["id", "schools", "trigger", "effects"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$",
      "description": "Namespaced spell id. Display name resolves via lang key spell.<id>.name."
    },
    "schools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["fire", "lightning", "water", "earth", "air", "holy", "necromancy", "arcane", "nature", "illusion"]
      },
      "description": "Spell schools (multi-value). Staff affinity: no penalty if ANY school matches; +50% mana when none match."
    },
    "mana_cost": {
      "type": "integer",
      "minimum": 0,
      "default": 10
    },
    "cooldown_ticks": {
      "type": "integer",
      "minimum": 0,
      "default": 40
    },
    "requires_learning": {
      "type": "boolean",
      "default": false,
      "description": "true = must be learned from a tome (grimoire) before casting."
    },
    "origin": {
      "type": "string",
      "default": "wizardreal:wizardry",
      "description": "Staff origin restriction; staff items carry origin.<ns>.<path> lang keys."
    },
    "threshold": {
      "type": "number",
      "minimum": -1,
      "maximum": 1,
      "default": -1,
      "description": "Match threshold override. -1 = use matcher default (text 0.8 / IPA 0.6); >=0 replaces the default outright (no template-level thresholds exist)."
    },
    "difficulty": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 3,
      "default": 1,
      "description": "Learning difficulty (0.4.0): the mastery requirement scales as 100 x difficulty points, so the same practice converts into less mastery. Forbidden chants use 2.0-3.0."
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [ { "required": ["aliases"] }, { "required": ["languages"] } ],
      "properties": {
        "aliases": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Legacy flat multilingual list (0.3.x compat): entries form the legacy bucket routed into every engine's grammar. Omit when languages is provided."
        },
        "languages": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z]{2}$" },
          "additionalProperties": { "type": "array", "items": { "type": "string" } },
          "description": "0.4.0 language buckets keyed by two-letter codes (en/zh/ja/ko). The player's selected engine decides which bucket reaches their recognizer; aliases[0] of a bucket is that language's primary word."
        },
        "ipa": {
          "type": "array",
          "items": { "type": "string" },
          "description": "IPA phoneme templates for the ipa-phonemes engine (cross-language path)."
        }
      }
    },
    "chants": {
      "oneOf": [
        { "$ref": "#/$defs/languageKeyedChants" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/chant" },
          "description": "Legacy variant array (0.3.x compat; retires with the spell-matrix rewrite)."
        }
      ],
      "description": "Ritual chant variants. Non-empty = ritual spell. In the 0.4.0 language-keyed shape each language declares a fixed trigger (first line / L1 entry gate) and cast (spell-name release line), plus body variants (two per language expected)."
    },
    "chant_policy": {
      "type": "object",
      "additionalProperties": false,
      "description": "0.4.0 chant tuning. Defaults: every completion at power 1.0, skipping allowed, interruptible, no pact.",
      "properties": {
        "power_per_line": {
          "type": "array",
          "items": { "type": "number", "minimum": 0 },
          "description": "Power multiplier for the Nth completed line (index 0 = line 1); lines beyond the table clamp to the last entry. Empty/absent = 1.0 for every completion."
        },
        "skip_allowed": {
          "type": "boolean",
          "default": true,
          "description": "Whether the spell-name jump (mid-chant early release) and the idle skip-cast (learning-gated) are permitted. Forbidden chants set false."
        },
        "interruptible": {
          "type": "boolean",
          "default": true,
          "description": "Whether damage may interrupt the chant (rolls back one line for 3+ line chants, fails shorter ones)."
        },
        "pact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["require"],
          "properties": {
            "require": { "const": "all_lines", "description": "Self-restriction: the full chant must be spoken." },
            "power_multiplier": { "type": "number", "default": 1.5 }
          },
          "description": "Optional self-restriction multiplier."
        }
      }
    },
    "chant_stages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/chantStage" },
      "description": "Chant-stage ladder (magic_eco 03): qualitative upgrade tiers, ascending by after_lines. A cast resolves to the highest tier whose after_lines <= completed chant lines AND mastery <= the caster's learning percent; under-mastery casts resolve down. Stage 0 (base) = the top-level effects."
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          { "$ref": "#/$defs/effects/projectile" },
          { "$ref": "#/$defs/effects/lightning" },
          { "$ref": "#/$defs/effects/heal" },
          { "$ref": "#/$defs/effects/status_effect" },
          { "$ref": "#/$defs/effects/knockback" },
          { "$ref": "#/$defs/effects/explosion" },
          { "$ref": "#/$defs/effects/beam" },
          { "$ref": "#/$defs/effects/sound" },
          { "$ref": "#/$defs/effects/particles" },
          { "$ref": "#/$defs/effects/hex" },
          { "$ref": "#/$defs/effects/bind" },
          { "$ref": "#/$defs/effects/pull" },
          { "$ref": "#/$defs/effects/blink" },
          { "$ref": "#/$defs/effects/surface" },
          { "$ref": "#/$defs/effects/barrier" },
          { "$ref": "#/$defs/effects/summon" },
          { "$ref": "#/$defs/effects/excavate" },
          { "$ref": "#/$defs/effects/harvest" },
          { "$ref": "#/$defs/effects/smelt" },
          { "$ref": "#/$defs/effects/visual" },
          { "$ref": "#/$defs/effects/weather" },
          { "$ref": "#/$defs/effects/light" },
          { "$ref": "#/$defs/effects/addon" }
        ]
      },
      "description": "Ordered effect list, executed sequentially."
    }
  },
  "$defs": {
    "resourceLocation": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
    },
    "languageKeyedChants": {
      "type": "object",
      "required": ["languages"],
      "additionalProperties": false,
      "properties": {
        "languages": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z]{2}$" },
          "additionalProperties": { "$ref": "#/$defs/langChant" }
        }
      }
    },
    "langChant": {
      "type": "object",
      "required": ["trigger", "cast"],
      "additionalProperties": false,
      "properties": {
        "trigger": {
          "$ref": "#/$defs/lineMeta",
          "description": "First line (L1) — the idle-state entry gate; fixed per language across all variants."
        },
        "cast": {
          "$ref": "#/$defs/lineMeta",
          "description": "Last line — the spell-name release line (early-release anchor); fixed per language across all variants."
        },
        "body": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "items": { "$ref": "#/$defs/lineMeta" }
          },
          "description": "Variant middle lines: one element per variant (an ordered list of middle lines); two variants per language are expected."
        }
      }
    },
    "lineMeta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Text recognition metadata for this line; aliases[0] is the text displayed on the HUD."
        },
        "ipa": {
          "type": "array",
          "items": { "type": "string" },
          "description": "IPA templates for this line (ipa-phonemes engine)."
        }
      }
    },
    "chant": {
      "type": "object",
      "required": ["lines"],
      "additionalProperties": false,
      "properties": {
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/line" }
        }
      }
    },
    "line": {
      "type": "object",
      "required": ["display_key"],
      "additionalProperties": false,
      "properties": {
        "display_key": {
          "type": "string",
          "description": "Lang key for this line's display text (e.g. wizardreal.chant.example.l1)."
        },
        "aliases": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Text recognition metadata for this line; a variant locks in when its first line (L1, index 0) is spoken."
        },
        "ipa": {
          "type": "array",
          "items": { "type": "string" },
          "description": "IPA templates for this line (ipa-phonemes engine)."
        }
      }
    },
    "chantStage": {
      "type": "object",
      "required": ["after_lines", "effects"],
      "additionalProperties": false,
      "properties": {
        "after_lines": {
          "type": "integer",
          "minimum": 1,
          "description": "Completed chant lines required (the L1 entry line counts as line 1); stages must ascend by this value."
        },
        "mastery": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 0,
          "description": "Learning-percent gate (0-100). Casts below the gate resolve down to the highest unlocked stage."
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              { "$ref": "#/$defs/effects/projectile" },
              { "$ref": "#/$defs/effects/lightning" },
              { "$ref": "#/$defs/effects/heal" },
              { "$ref": "#/$defs/effects/status_effect" },
              { "$ref": "#/$defs/effects/knockback" },
              { "$ref": "#/$defs/effects/explosion" },
              { "$ref": "#/$defs/effects/beam" },
              { "$ref": "#/$defs/effects/sound" },
              { "$ref": "#/$defs/effects/particles" },
              { "$ref": "#/$defs/effects/hex" },
              { "$ref": "#/$defs/effects/bind" },
              { "$ref": "#/$defs/effects/pull" },
              { "$ref": "#/$defs/effects/blink" },
              { "$ref": "#/$defs/effects/surface" },
              { "$ref": "#/$defs/effects/barrier" },
              { "$ref": "#/$defs/effects/summon" },
              { "$ref": "#/$defs/effects/excavate" },
              { "$ref": "#/$defs/effects/harvest" },
              { "$ref": "#/$defs/effects/smelt" },
              { "$ref": "#/$defs/effects/visual" },
              { "$ref": "#/$defs/effects/weather" },
              { "$ref": "#/$defs/effects/light" },
              { "$ref": "#/$defs/effects/addon" }
            ]
          },
          "description": "Effect list replacing the base effects when this tier resolves."
        },
        "mana_cost": {
          "type": "integer",
          "minimum": 0,
          "description": "Mana override for casts resolved at this tier (default = the spell's base mana_cost)."
        },
        "cooldown_ticks": {
          "type": "integer",
          "minimum": 0,
          "description": "Cooldown override for casts resolved at this tier (default = the spell's base cooldown_ticks)."
        }
      }
    },
    "effects": {
      "projectile": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "entity"],
        "properties": {
          "type": { "const": "wizardreal:projectile" },
          "entity": { "$ref": "#/$defs/resourceLocation", "description": "Entity id to launch (e.g. minecraft:small_fireball)." },
          "speed": { "type": "number", "default": 1.5 },
          "count": { "type": "integer", "minimum": 1, "default": 1 },
          "spread": { "type": "number", "minimum": 0, "default": 0 }
        }
      },
      "lightning": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": { "const": "wizardreal:lightning" },
          "range": { "type": "number", "minimum": 0, "default": 48, "description": "Strike at the looked-at block within range." }
        }
      },
      "heal": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "amount"],
        "properties": {
          "type": { "const": "wizardreal:heal" },
          "amount": { "type": "number", "exclusiveMinimum": 0, "description": "Hearts healed on the caster." }
        }
      },
      "status_effect": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "effect"],
        "properties": {
          "type": { "const": "wizardreal:status_effect" },
          "effect": { "$ref": "#/$defs/resourceLocation", "description": "Mob effect id (e.g. minecraft:speed)." },
          "duration": { "type": "integer", "minimum": 1, "default": 200 },
          "amplifier": { "type": "integer", "minimum": 0, "default": 0 }
        }
      },
      "knockback": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": { "const": "wizardreal:knockback" },
          "range": { "type": "number", "minimum": 0, "default": 6 },
          "angle_cos": { "type": "number", "minimum": -1, "maximum": 1, "default": 0.5, "description": "Look-direction cone half-angle as cosine." },
          "power": { "type": "number", "minimum": 0, "default": 1.1 }
        }
      },
      "explosion": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "description": "Explosion at the looked-at point; breaks blocks.",
        "properties": {
          "type": { "const": "wizardreal:explosion" },
          "range": { "type": "number", "minimum": 0, "default": 16 },
          "power": { "type": "number", "minimum": 0, "default": 4 },
          "set_fire": { "type": "boolean", "default": false }
        }
      },
      "beam": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": { "const": "wizardreal:beam" },
          "range": { "type": "number", "minimum": 0, "default": 30 },
          "width": { "type": "number", "minimum": 0, "default": 1 },
          "damage": { "type": "number", "minimum": 0, "default": 8 },
          "set_fire": { "type": "boolean", "default": false },
          "fire_seconds": { "type": "integer", "minimum": 0, "default": 3 }
        }
      },
      "sound": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "sound"],
        "properties": {
          "type": { "const": "wizardreal:sound" },
          "sound": { "$ref": "#/$defs/resourceLocation", "description": "Sound event id (e.g. wizardreal:spell.cast_ignis)." },
          "volume": { "type": "number", "minimum": 0, "default": 1 },
          "pitch": { "type": "number", "minimum": 0, "default": 1 }
        }
      },
      "particles": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "particle"],
        "properties": {
          "type": { "const": "wizardreal:particles" },
          "particle": { "$ref": "#/$defs/resourceLocation", "description": "Simple (no-argument) particle type id." },
          "count": { "type": "integer", "minimum": 0, "default": 10 },
          "spread": { "type": "number", "minimum": 0, "default": 0.5 },
          "speed": { "type": "number", "minimum": 0, "default": 0.1 },
          "y_offset": { "type": "number", "default": 1 }
        }
      },
      "hex": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "effect"],
        "properties": {
          "type": { "const": "wizardreal:hex" },
          "effect": { "$ref": "#/$defs/resourceLocation", "description": "Mob effect id applied to enemies (never the caster)." },
          "amplifier": { "type": "integer", "minimum": 0, "default": 0 },
          "duration": { "type": "integer", "minimum": 1, "default": 100 },
          "range": { "type": "number", "minimum": 0, "default": 8, "description": "Cone length when angle_cos is set, else the default radius." },
          "angle_cos": { "type": "number", "minimum": -1, "maximum": 1, "description": "Set to target a look cone instead of a sphere." },
          "radius": { "type": "number", "minimum": 0, "description": "Sphere radius override (defaults to range)." },
          "at_target": { "type": "boolean", "default": false, "description": "Centre the sphere on the aimed point instead of the caster." },
          "mob_filter": { "type": "string", "description": "Optional entity-type tag id (e.g. minecraft:undead) filtering targets." }
        }
      },
      "bind": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": { "const": "wizardreal:bind" },
          "duration": { "type": "integer", "minimum": 1, "default": 60 },
          "range": { "type": "number", "minimum": 0, "default": 16 },
          "angle_cos": { "type": "number", "minimum": -1, "maximum": 1, "default": 0.75 },
          "group": { "type": "boolean", "default": false, "description": "true = root every cone target; false = nearest single target." }
        },
        "description": "Movement lock (speed 0 + jump lock); boss-grade targets (max health >= 100) are immune."
      },
      "pull": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": { "const": "wizardreal:pull" },
          "range": { "type": "number", "minimum": 0, "default": 6 },
          "strength": { "type": "number", "minimum": 0, "default": 0.8 },
          "include_items": { "type": "boolean", "default": true }
        },
        "description": "Velocity-impulse drag of entities (and dropped items) toward the caster."
      },
      "blink": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": { "const": "wizardreal:blink" },
          "distance": { "type": "number", "minimum": 0, "default": 6 }
        },
        "description": "Marches the caster's bounding box along the look vector; lands at the farthest collision-free spot, fizzles without teleporting when none exists."
      },
      "surface": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "block"],
        "properties": {
          "type": { "const": "wizardreal:surface" },
          "block": { "$ref": "#/$defs/resourceLocation" },
          "shape": { "enum": ["circle", "line"], "default": "circle" },
          "radius": { "type": "number", "minimum": 0, "default": 2 },
          "duration_ticks": { "type": "integer", "minimum": 1, "default": 200 }
        },
        "description": "Temporary ground cover on replaceable surface only; every block restores itself on expiry."
      },
      "barrier": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "block"],
        "properties": {
          "type": { "const": "wizardreal:barrier" },
          "block": { "$ref": "#/$defs/resourceLocation" },
          "shape": { "enum": ["wall", "ring", "cage"], "default": "wall" },
          "width": { "type": "integer", "minimum": 1, "default": 3 },
          "height": { "type": "integer", "minimum": 1, "default": 3 },
          "radius": { "type": "number", "minimum": 0, "default": 2 },
          "duration_ticks": { "type": "integer", "minimum": 1, "default": 200 }
        },
        "description": "Temporary structure perpendicular to the look direction (wall), a circle of pillars (ring) or a spherical shell around the aimed point (cage); restores on expiry."
      },
      "summon": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "entity"],
        "properties": {
          "type": { "const": "wizardreal:summon" },
          "entity": { "$ref": "#/$defs/resourceLocation" },
          "count": { "type": "integer", "minimum": 1, "default": 1 },
          "duration_ticks": { "type": "integer", "minimum": 1, "default": 600 },
          "follow": { "type": "boolean", "default": true, "description": "Tameable types are tamed to the caster; hostile types are pointed at the nearest monster." }
        },
        "description": "Temporary summons discarded with a poof on expiry (hard cap 6 per cast)."
      },
      "excavate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": { "const": "wizardreal:excavate" },
          "shape": { "enum": ["tunnel", "area"], "default": "tunnel" },
          "length": { "type": "number", "minimum": 0, "default": 8 },
          "radius": { "type": "number", "minimum": 0, "default": 1 }
        },
        "description": "Mining magic: a walkable corridor along the look vector or a sphere scoop at the aimed point; unbreakable blocks and liquids skipped (256-block cap)."
      },
      "harvest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": { "const": "wizardreal:harvest" },
          "radius": { "type": "number", "minimum": 0, "default": 3 },
          "mode": { "enum": ["harvest", "grow"], "default": "harvest" },
          "replant": { "type": "boolean", "default": true }
        },
        "description": "Farming magic: break mature crops (replant at age 0) or bonemeal-rush growables around the aimed point."
      },
      "smelt": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": { "const": "wizardreal:smelt" },
          "radius": { "type": "number", "minimum": 0, "default": 1.5 }
        },
        "description": "Touch-smelting: ore/smelt blocks around the aimed point pop their furnace product + XP."
      },
      "visual": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "particle"],
        "properties": {
          "type": { "const": "wizardreal:visual" },
          "particle": {
            "oneOf": [
              { "$ref": "#/$defs/resourceLocation", "description": "Simple (no-argument) particle id." },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["dust"],
                "properties": {
                  "dust": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
                  "dust_scale": { "type": "number", "default": 1 }
                }
              }
            ]
          },
          "shape": { "enum": ["ring", "helix", "pillar", "burst", "trail", "cone", "cross", "orbit"], "default": "ring" },
          "radius": { "type": "number", "minimum": 0, "default": 1.5 },
          "count": { "type": "integer", "minimum": 1, "default": 30 },
          "duration_ticks": { "type": "integer", "minimum": 1, "default": 20 },
          "y_offset": { "type": "number", "default": 1 },
          "at_point": { "type": "boolean", "default": false, "description": "true = centre on the aimed point instead of the caster." }
        },
        "description": "Choreographed spell visuals played back over duration_ticks (magic_eco 05)."
      },
      "weather": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": { "const": "wizardreal:weather" },
          "mode": { "enum": ["rain", "thunder", "clear"], "default": "rain" },
          "duration_seconds": { "type": "integer", "minimum": 1, "default": 120 }
        }
      },
      "light": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": { "const": "wizardreal:light" },
          "glow_range": { "type": "number", "minimum": 0, "default": 0, "description": "0 = no glow marking." },
          "glow_duration": { "type": "integer", "minimum": 1, "default": 100 },
          "night_vision_seconds": { "type": "integer", "minimum": 0, "default": 0, "description": "0 = no night vision." }
        },
