{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theoroi.dev/schemas/wizardreal/spell.schema.json",
  "title": "wizardreal spell definition",
  "description": "Data-driven spell definition for data/<ns>/voicecast/spells/<file>.json, parsed by SpellDefinition.CODEC (wizardreal-common). Field documentation: docs/spells/spell_json.md in the workspace root repo. Addon-registered effect types are covered by the generic branch of the effects anyOf; built-in types are enumerated for editor assistance. Runtime parsing is lenient about unknown top-level keys, but this schema is stricter by design (typo protection).",
  "type": "object",
  "required": ["id", "schools", "trigger", "effects"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$",
      "description": "Namespaced spell id. Display name resolves via lang key spell.<id>.name."
    },
    "schools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["fire", "lightning", "water", "earth", "air", "holy", "necromancy", "arcane", "nature", "illusion"]
      },
      "description": "Spell schools (multi-value). Staff affinity: no penalty if ANY school matches; +50% mana when none match."
    },
    "mana_cost": {
      "type": "integer",
      "minimum": 0,
      "default": 10
    },
    "cooldown_ticks": {
      "type": "integer",
      "minimum": 0,
      "default": 40
    },
    "requires_learning": {
      "type": "boolean",
      "default": false,
      "description": "true = must be learned from a tome (grimoire) before casting."
    },
    "origin": {
      "type": "string",
      "default": "wizardreal:wizardry",
      "description": "Staff origin restriction; staff items carry origin.<ns>.<path> lang keys."
    },
    "threshold": {
      "type": "number",
      "minimum": -1,
      "maximum": 1,
      "default": -1,
      "description": "Match threshold override. -1 = use matcher default (text 0.8 / IPA 0.6); >=0 replaces the default outright (no template-level thresholds exist)."
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [ { "required": ["aliases"] }, { "required": ["languages"] } ],
      "properties": {
        "aliases": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Legacy flat multilingual list (0.3.x compat): entries form the legacy bucket routed into every engine's grammar. Omit when languages is provided."
        },
        "languages": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z]{2}$" },
          "additionalProperties": { "type": "array", "items": { "type": "string" } },
          "description": "0.4.0 language buckets keyed by two-letter codes (en/zh/ja/ko). The player's selected engine decides which bucket reaches their recognizer; aliases[0] of a bucket is that language's primary word."
        },
        "ipa": {
          "type": "array",
          "items": { "type": "string" },
          "description": "IPA phoneme templates for the ipa-phonemes engine (cross-language path)."
        }
      }
    },
    "chants": {
      "oneOf": [
        { "$ref": "#/$defs/languageKeyedChants" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/chant" },
          "description": "Legacy variant array (0.3.x compat; retires with the spell-matrix rewrite)."
        }
      ],
      "description": "Ritual chant variants. Non-empty = ritual spell. In the 0.4.0 language-keyed shape each language declares a fixed trigger (first line / L1 entry gate) and cast (spell-name release line), plus body variants (two per language expected)."
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          { "$ref": "#/$defs/effects/projectile" },
          { "$ref": "#/$defs/effects/lightning" },
          { "$ref": "#/$defs/effects/heal" },
          { "$ref": "#/$defs/effects/status_effect" },
          { "$ref": "#/$defs/effects/knockback" },
          { "$ref": "#/$defs/effects/explosion" },
          { "$ref": "#/$defs/effects/beam" },
          { "$ref": "#/$defs/effects/sound" },
          { "$ref": "#/$defs/effects/particles" },
          { "$ref": "#/$defs/effects/addon" }
        ]
      },
      "description": "Ordered effect list, executed sequentially."
    }
  },
  "$defs": {
    "resourceLocation": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
    },
    "languageKeyedChants": {
      "type": "object",
      "required": ["languages"],
      "additionalProperties": false,
      "properties": {
        "languages": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z]{2}$" },
          "additionalProperties": { "$ref": "#/$defs/langChant" }
        }
      }
    },
    "langChant": {
      "type": "object",
      "required": ["trigger", "cast"],
      "additionalProperties": false,
      "properties": {
        "trigger": {
          "$ref": "#/$defs/lineMeta",
          "description": "First line (L1) — the idle-state entry gate; fixed per language across all variants."
        },
        "cast": {
          "$ref": "#/$defs/lineMeta",
          "description": "Last line — the spell-name release line (early-release anchor); fixed per language across all variants."
        },
        "body": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "items": { "$ref": "#/$defs/lineMeta" }
          },
          "description": "Variant middle lines: one element per variant (an ordered list of middle lines); two variants per language are expected."
        }
      }
    },
    "lineMeta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Text recognition metadata for this line; aliases[0] is the text displayed on the HUD."
        },
        "ipa": {
          "type": "array",
          "items": { "type": "string" },
          "description": "IPA templates for this line (ipa-phonemes engine)."
        }
      }
    },
    "chant": {
      "type": "object",
      "required": ["lines"],
      "additionalProperties": false,
      "properties": {
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/line" }
        }
      }
    },
    "line": {
      "type": "object",
      "required": ["display_key"],
      "additionalProperties": false,
      "properties": {
        "display_key": {
          "type": "string",
          "description": "Lang key for this line's display text (e.g. wizardreal.chant.example.l1)."
        },
        "aliases": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Text recognition metadata for this line; a variant locks in when its first line (L1, index 0) is spoken."
        },
        "ipa": {
          "type": "array",
          "items": { "type": "string" },
          "description": "IPA templates for this line (ipa-phonemes engine)."
        }
      }
    },
    "effects": {
      "projectile": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "entity"],
        "properties": {
          "type": { "const": "wizardreal:projectile" },
          "entity": { "$ref": "#/$defs/resourceLocation", "description": "Entity id to launch (e.g. minecraft:small_fireball)." },
          "speed": { "type": "number", "default": 1.5 },
          "count": { "type": "integer", "minimum": 1, "default": 1 },
          "spread": { "type": "number", "minimum": 0, "default": 0 }
        }
      },
      "lightning": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": { "const": "wizardreal:lightning" },
          "range": { "type": "number", "minimum": 0, "default": 48, "description": "Strike at the looked-at block within range." }
        }
      },
      "heal": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "amount"],
        "properties": {
          "type": { "const": "wizardreal:heal" },
          "amount": { "type": "number", "exclusiveMinimum": 0, "description": "Hearts healed on the caster." }
        }
      },
      "status_effect": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "effect"],
        "properties": {
          "type": { "const": "wizardreal:status_effect" },
          "effect": { "$ref": "#/$defs/resourceLocation", "description": "Mob effect id (e.g. minecraft:speed)." },
          "duration": { "type": "integer", "minimum": 1, "default": 200 },
          "amplifier": { "type": "integer", "minimum": 0, "default": 0 }
        }
      },
      "knockback": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": { "const": "wizardreal:knockback" },
          "range": { "type": "number", "minimum": 0, "default": 6 },
          "angle_cos": { "type": "number", "minimum": -1, "maximum": 1, "default": 0.5, "description": "Look-direction cone half-angle as cosine." },
          "power": { "type": "number", "minimum": 0, "default": 1.1 }
        }
      },
      "explosion": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "description": "Explosion at the looked-at point; breaks blocks.",
        "properties": {
          "type": { "const": "wizardreal:explosion" },
          "range": { "type": "number", "minimum": 0, "default": 16 },
          "power": { "type": "number", "minimum": 0, "default": 4 },
          "set_fire": { "type": "boolean", "default": false }
        }
      },
      "beam": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": { "const": "wizardreal:beam" },
          "range": { "type": "number", "minimum": 0, "default": 30 },
          "width": { "type": "number", "minimum": 0, "default": 1 },
          "damage": { "type": "number", "minimum": 0, "default": 8 },
          "set_fire": { "type": "boolean", "default": false },
          "fire_seconds": { "type": "integer", "minimum": 0, "default": 3 }
        }
      },
      "sound": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "sound"],
        "properties": {
          "type": { "const": "wizardreal:sound" },
          "sound": { "$ref": "#/$defs/resourceLocation", "description": "Sound event id (e.g. wizardreal:spell.cast_ignis)." },
          "volume": { "type": "number", "minimum": 0, "default": 1 },
          "pitch": { "type": "number", "minimum": 0, "default": 1 }
        }
      },
      "particles": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "particle"],
        "properties": {
          "type": { "const": "wizardreal:particles" },
          "particle": { "$ref": "#/$defs/resourceLocation", "description": "Simple (no-argument) particle type id." },
          "count": { "type": "integer", "minimum": 0, "default": 10 },
          "spread": { "type": "number", "minimum": 0, "default": 0.5 },
          "speed": { "type": "number", "minimum": 0, "default": 0.1 },
          "y_offset": { "type": "number", "default": 1 }
        }
      },
      "addon": {
        "type": "object",
        "required": ["type"],
        "description": "Effect type registered by an addon mod via EffectRegistry (type must not be a built-in id). Parameter schema is defined by the addon."
      }
    }
  },
  "examples": [
    {
      "id": "wizardreal:ignis",
      "schools": ["fire"],
      "mana_cost": 5,
      "cooldown_ticks": 40,
      "requires_learning": false,
      "origin": "wizardreal:wizardry",
      "threshold": -1.0,
      "trigger": {
        "languages": { "en": ["ignis", "fire"], "zh": ["火球"], "ja": ["イグニス"], "ko": [] },
        "ipa": []
      },
      "chants": {
        "languages": {
          "en": {
            "trigger": { "aliases": ["o flame"] },
            "cast": { "aliases": ["ignis"] },
            "body": [ [ { "aliases": ["variant-a mid"] } ], [ { "aliases": ["variant-b mid"] } ] ]
          }
        }
      },
      "effects": [
        { "type": "wizardreal:projectile", "entity": "minecraft:small_fireball", "speed": 1.5 },
        { "type": "wizardreal:sound", "sound": "minecraft:entity.blaze.shoot", "volume": 1.0, "pitch": 1.2 }
      ]
    }
  ]
}
